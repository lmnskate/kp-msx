# Server
SERVER_HOST=your-server-ip
SERVER_PORT=1234
SERVER_SCHEME=http
SERVER_SQLITE_URL=./kp-sqlite.db
SERVER_WORKERS=4
SERVER_PROXY_HEADERS=true

# Bind address (optional, defaults to 0.0.0.0:SERVER_PORT).
# Set both when a reverse proxy (nginx) holds the public port — see README.
#SERVER_BIND_HOST=127.0.0.1
#SERVER_BIND_PORT=8000

# KinoPub API
KP_CLIENT_ID=
KP_CLIENT_SECRET=
KP_PROTOCOL=hls4
KP_QUALITY=1080p